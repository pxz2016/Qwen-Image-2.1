# 默认：单卡共享。两个 vLLM 实例不会协调显存；0.45 只是起步预算。
T2I_GPU=0
EDIT_GPU=0
T2I_MEM_UTIL=0.45
EDIT_MEM_UTIL=0.45

# 可按工作负载调整上下文、图片数和 CUDA graph 回退。EAGER=1 会启用
# serve.sh 的 --enforce-eager 回退。
T2I_MAX_LEN=24576
EDIT_MAX_LEN=32768
T2I_MAX_IMGS=10
EDIT_MAX_IMGS=2
T2I_EAGER=0
EDIT_EAGER=0

# 双卡独占示例（取消下面四行注释，并删除或覆盖上面的同名值）：
# T2I_GPU=0
# EDIT_GPU=1
# T2I_MEM_UTIL=0.85
# EDIT_MEM_UTIL=0.85
#
# 先用 nvidia-smi 确认每张卡的实际总显存和空闲显存。单卡运行两个实例时，
# 不要将两者都设为 0.90；0.45 不保证显存或吞吐足够。
